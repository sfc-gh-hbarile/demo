                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "APPROVED",
                "label": "Approved",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "WEIGHTED",
                "label": "Weighted pipeline",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
