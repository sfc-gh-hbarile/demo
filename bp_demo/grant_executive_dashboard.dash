{
  "version": 2,
  "title": "Grant Portfolio & Donor Pipeline — Executive Dashboard",
  "filters": {
    "PROGRAM_AREA": {
      "label": "Program area",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "static",
        "values": [
          "Arts",
          "Education",
          "Environment",
          "Government Innovation",
          "Public Health"
        ]
      },
      "default_values": []
    },
    "REGION": {
      "label": "Region",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "static",
        "values": [
          "Africa",
          "East Asia & Pacific",
          "Europe",
          "Latin America",
          "North America",
          "South Asia"
        ]
      },
      "default_values": []
    },
    "STATUS": {
      "label": "Status",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "static",
        "values": [
          "Approved",
          "Declined",
          "Draft",
          "Paid",
          "Submitted",
          "Under Review"
        ]
      },
      "default_values": []
    },
    "RISK_RATING": {
      "label": "Risk rating",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "static",
        "values": [
          "High",
          "Low",
          "Medium"
        ]
      },
      "default_values": []
    },
    "PROGRAM_OFFICER": {
      "label": "Program officer",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "query",
        "datasources": [
          "ds-PROGRAM_OFFICER-options"
        ]
      },
      "default_values": []
    },
    "SUBMITTED_DATE": {
      "label": "Submitted date",
      "mode": "range",
      "valueType": "DATE",
      "default_values": []
    }
  },
  "variables": {
    "metric": {
      "label": "Breakdown metric",
      "valueType": "FIELD",
      "default_values": [
        "APPROVED_AMOUNT"
      ],
      "options": {
        "source": "static",
        "values": [
          "APPROVED_AMOUNT",
          "REQUESTED_AMOUNT",
          "WEIGHTED_PIPELINE_AMOUNT",
          "COMMITTED_AMOUNT"
        ]
      },
      "mode": "single_select"
    },
    "top_n": {
      "label": "Top N grants",
      "valueType": "NUMBER",
      "default_values": [
        25
      ],
      "options": {
        "source": "static",
        "values": [
          "5",
          "100",
          "5"
        ]
      },
      "mode": "slider"
    },
    "donor_top_n": {
      "label": "Top N donors",
      "valueType": "NUMBER",
      "default_values": [
        10
      ],
      "options": {
        "source": "static",
        "values": [
          "5",
          "30",
          "5"
        ]
      },
      "mode": "slider"
    }
  },
  "hierarchies": {
    "program": {
      "label": "Program",
      "levels": [
        {
          "id": "program_area",
          "label": "Program area",
          "key": {
            "expr": "PROGRAM_AREA",
            "type": "STRING"
          },
          "display": "PROGRAM_AREA",
          "group_by": [
            "PROGRAM_AREA"
          ]
        },
        {
          "id": "initiative",
          "label": "Initiative",
          "key": {
            "expr": "INITIATIVE_KEY",
            "type": "STRING"
          },
          "display": "INITIATIVE",
          "group_by": [
            "INITIATIVE_KEY",
            "INITIATIVE"
          ]
        }
      ]
    },
    "geo": {
      "label": "Geography",
      "levels": [
        {
          "id": "region",
          "label": "Region",
          "key": {
            "expr": "REGION",
            "type": "STRING"
          },
          "display": "REGION",
          "group_by": [
            "REGION"
          ]
        },
        {
          "id": "country",
          "label": "Country",
          "key": {
            "expr": "COUNTRY_KEY",
            "type": "STRING"
          },
          "display": "COUNTRY",
          "group_by": [
            "COUNTRY_KEY",
            "COUNTRY"
          ]
        }
      ]
    },
    "budget": {
      "label": "Budget",
      "levels": [
        {
          "id": "program_area",
          "label": "Program area",
          "key": {
            "expr": "PROGRAM_AREA",
            "type": "STRING"
          },
          "display": "PROGRAM_AREA",
          "group_by": [
            "PROGRAM_AREA"
          ]
        },
        {
          "id": "grant",
          "label": "Grant",
          "key": {
            "expr": "GRANT_ID",
            "type": "STRING"
          },
          "display": "GRANT_LABEL",
          "group_by": [
            "GRANT_ID",
            "GRANT_LABEL"
          ]
        },
        {
          "id": "line",
          "label": "Budget line",
          "key": {
            "expr": "LINE_KEY",
            "type": "STRING"
          },
          "display": "BUDGET_LINE",
          "group_by": [
            "LINE_KEY",
            "BUDGET_LINE"
          ]
        }
      ]
    }
  },
  "scopes": {
    "quarter_hover": {},
    "program_drill": {},
    "status_highlight": {}
  },
  "datasources": {
    "ds-kpi-trend": {
      "type": "sql",
      "columns": [
        {
          "name": "QTR",
          "type": "DATE"
        },
        {
          "name": "Q_GRANTS",
          "type": "NUMBER"
        },
        {
          "name": "Q_REQ",
          "type": "NUMBER"
        },
        {
          "name": "Q_APPR",
          "type": "NUMBER"
        },
        {
          "name": "Q_PIPE",
          "type": "NUMBER"
        },
        {
          "name": "Q_WPIPE",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        },
        {
          "name": "REQUESTED",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED",
          "type": "NUMBER"
        },
        {
          "name": "PIPELINE",
          "type": "NUMBER"
        },
        {
          "name": "WEIGHTED",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH g AS (\n    SELECT *\n    FROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\n    WHERE\n        {{ filter('PROGRAM_AREA') }}\n        AND {{ filter('REGION') }}\n        AND {{ filter('STATUS') }}\n        AND {{ filter('RISK_RATING') }}\n        AND {{ filter('PROGRAM_OFFICER') }}\n        AND {{ filter('SUBMITTED_DATE') }}\n),\nq AS (\n    SELECT\n        DATE_TRUNC('QUARTER', SUBMITTED_DATE)::DATE AS QTR,\n        COUNT(*) AS Q_GRANTS,\n        SUM(REQUESTED_AMOUNT) AS Q_REQ,\n        SUM(COALESCE(APPROVED_AMOUNT, 0)) AS Q_APPR,\n        SUM(PIPELINE_AMOUNT) AS Q_PIPE,\n        SUM(WEIGHTED_PIPELINE_AMOUNT) AS Q_WPIPE\n    FROM g\n    GROUP BY\n        1\n)\nSELECT\n    QTR,\n    Q_GRANTS,\n    Q_REQ,\n    Q_APPR,\n    Q_PIPE,\n    Q_WPIPE,\n    SUM(Q_GRANTS) OVER () AS GRANTS,\n    SUM(Q_REQ) OVER () AS REQUESTED,\n    SUM(Q_APPR) OVER () AS APPROVED,\n    SUM(Q_PIPE) OVER () AS PIPELINE,\n    SUM(Q_WPIPE) OVER () AS WEIGHTED\nFROM q\nORDER BY\n    QTR",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-kpi-totals": {
      "type": "sql",
      "columns": [
        {
          "name": "ORGS",
          "type": "NUMBER"
        },
        {
          "name": "WIN_RATE",
          "type": "NUMBER"
        },
        {
          "name": "COMMITTED",
          "type": "NUMBER"
        },
        {
          "name": "AVG_SCORE",
          "type": "NUMBER"
        },
        {
          "name": "AVG_DAYS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    COUNT(DISTINCT ORGANIZATION_NAME) AS ORGS,\n    COUNT_IF(STATUS IN ('Approved', 'Paid')) / NULLIF(COUNT_IF(STATUS IN ('Approved', 'Paid', 'Declined')), 0) AS WIN_RATE,\n    SUM(COMMITTED_AMOUNT) AS COMMITTED,\n    AVG(REVIEWER_SCORE) AS AVG_SCORE,\n    AVG(DATEDIFF('day', SUBMITTED_DATE, DECISION_DATE)) AS AVG_DAYS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-quarterly": {
      "type": "sql",
      "columns": [
        {
          "name": "QTR",
          "type": "DATE"
        },
        {
          "name": "REQUESTED_M",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED_M",
          "type": "NUMBER"
        },
        {
          "name": "WON",
          "type": "NUMBER"
        },
        {
          "name": "AVG_DAYS",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    DATE_TRUNC('QUARTER', SUBMITTED_DATE)::DATE AS QTR,\n    ROUND(SUM(REQUESTED_AMOUNT) / 1e6, 2) AS REQUESTED_M,\n    ROUND(SUM(COALESCE(APPROVED_AMOUNT, 0)) / 1e6, 2) AS APPROVED_M,\n    COUNT_IF(STATUS IN ('Approved', 'Paid')) AS WON,\n    ROUND(AVG(DATEDIFF('day', SUBMITTED_DATE, DECISION_DATE)), 0) AS AVG_DAYS,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    1\nORDER BY\n    1",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-status-mix": {
      "type": "sql",
      "columns": [
        {
          "name": "STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        },
        {
          "name": "REQUESTED_M",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    STATUS,\n    COUNT(*) AS GRANTS,\n    ROUND(SUM(REQUESTED_AMOUNT) / 1e6, 2) AS REQUESTED_M\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    STATUS\nORDER BY\n    GRANTS DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-program-drill": {
      "type": "sql",
      "columns": [
        {
          "name": "VALUE_M",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH base AS (\n    SELECT\n        PROGRAM_AREA,\n        PROGRAM_AREA || ' | ' || INITIATIVE AS INITIATIVE_KEY,\n        INITIATIVE,\n        {{ var('metric') }} AS METRIC_VALUE\n    FROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\n    WHERE\n        {{ filter('PROGRAM_AREA') }}\n        AND {{ filter('REGION') }}\n        AND {{ filter('STATUS') }}\n        AND {{ filter('RISK_RATING') }}\n        AND {{ filter('PROGRAM_OFFICER') }}\n        AND {{ filter('SUBMITTED_DATE') }}\n)\nSELECT\n    {{ hierarchy_key('program') }},\n    ROUND(SUM(METRIC_VALUE) / 1e6, 2) AS VALUE_M,\n    COUNT(*) AS GRANTS\nFROM base\nWHERE\n    {{ hierarchy_rows('program') }}\nGROUP BY\n    {{ hierarchy_key('program') }}\nORDER BY\n    VALUE_M DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "variable_bindings": [
        {
          "variable_id": "metric"
        }
      ],
      "hierarchy_bindings": [
        {
          "hierarchy_id": "program"
        }
      ]
    },
    "ds-geo-tree": {
      "type": "sql",
      "columns": [
        {
          "name": "GRANTS",
          "type": "NUMBER"
        },
        {
          "name": "REQUESTED",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED",
          "type": "NUMBER"
        },
        {
          "name": "WEIGHTED",
          "type": "NUMBER"
        },
        {
          "name": "AVG_SCORE",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH base AS (\n    SELECT\n        REGION,\n        REGION || ' | ' || COUNTRY AS COUNTRY_KEY,\n        COUNTRY,\n        REQUESTED_AMOUNT,\n        APPROVED_AMOUNT,\n        WEIGHTED_PIPELINE_AMOUNT,\n        REVIEWER_SCORE\n    FROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\n    WHERE\n        {{ filter('PROGRAM_AREA') }}\n        AND {{ filter('REGION') }}\n        AND {{ filter('STATUS') }}\n        AND {{ filter('RISK_RATING') }}\n        AND {{ filter('PROGRAM_OFFICER') }}\n        AND {{ filter('SUBMITTED_DATE') }}\n)\nSELECT\n    {{ hierarchy_key('geo') }},\n    COUNT(*) AS GRANTS,\n    SUM(REQUESTED_AMOUNT) AS REQUESTED,\n    SUM(COALESCE(APPROVED_AMOUNT, 0)) AS APPROVED,\n    SUM(WEIGHTED_PIPELINE_AMOUNT) AS WEIGHTED,\n    ROUND(AVG(REVIEWER_SCORE), 2) AS AVG_SCORE\nFROM base\nWHERE\n    {{ hierarchy_rows('geo') }}\nGROUP BY\n    {{ hierarchy_key('geo') }}\nORDER BY\n    REQUESTED DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "hierarchy_bindings": [
        {
          "hierarchy_id": "geo"
        }
      ]
    },
    "ds-type-status": {
      "type": "sql",
      "columns": [
        {
          "name": "GRANT_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    GRANT_TYPE,\n    STATUS,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    GRANT_TYPE,\n    STATUS",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-officer-metric": {
      "type": "sql",
      "columns": [
        {
          "name": "OFFICER",
          "type": "VARCHAR"
        },
        {
          "name": "VALUE_M",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    PROGRAM_OFFICER AS OFFICER,\n    ROUND(SUM({{ var('metric') }}) / 1e6, 2) AS VALUE_M,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    PROGRAM_OFFICER\nORDER BY\n    VALUE_M DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "variable_bindings": [
        {
          "variable_id": "metric"
        }
      ]
    },
    "ds-program-risk": {
      "type": "sql",
      "columns": [
        {
          "name": "PROGRAM_AREA",
          "type": "VARCHAR"
        },
        {
          "name": "RISK_RATING",
          "type": "VARCHAR"
        },
        {
          "name": "APPROVED_M",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    PROGRAM_AREA,\n    RISK_RATING,\n    ROUND(SUM(COALESCE(APPROVED_AMOUNT, 0)) / 1e6, 1) AS APPROVED_M,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    PROGRAM_AREA,\n    RISK_RATING",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-opp-kpis": {
      "type": "sql",
      "columns": [
        {
          "name": "OPPS",
          "type": "NUMBER"
        },
        {
          "name": "OPP_AMOUNT",
          "type": "NUMBER"
        },
        {
          "name": "OPP_WEIGHTED",
          "type": "NUMBER"
        },
        {
          "name": "CLOSED_WON",
          "type": "NUMBER"
        },
        {
          "name": "OPP_WIN_RATE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    COUNT(*) AS OPPS,\n    SUM(O.AMOUNT) AS OPP_AMOUNT,\n    SUM(O.AMOUNT * O.PROBABILITY_PCT / 100) AS OPP_WEIGHTED,\n    SUM(IFF(O.STAGE = 'Closed Won', O.AMOUNT, 0)) AS CLOSED_WON,\n    COUNT_IF(O.STAGE = 'Closed Won') / NULLIF(COUNT_IF(O.STAGE IN ('Closed Won', 'Closed Lost')), 0) AS OPP_WIN_RATE\nFROM BP_DEMO.CURATED.DT_OPPS_FLAT O\nLEFT JOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON O.GRANT_ID_REF = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-opp-funnel": {
      "type": "sql",
      "columns": [
        {
          "name": "STAGE",
          "type": "VARCHAR"
        },
        {
          "name": "STAGE_ORDER",
          "type": "NUMBER"
        },
        {
          "name": "OPPS",
          "type": "NUMBER"
        },
        {
          "name": "AMOUNT_M",
          "type": "NUMBER"
        },
        {
          "name": "PROBABILITY",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    O.STAGE,\n    DECODE(O.STAGE, 'Prospecting', 1, 'Cultivation', 2, 'Solicitation', 3, 'Negotiation', 4, 'Committed', 5, 'Closed Won', 6, 'Closed Lost', 7) AS STAGE_ORDER,\n    COUNT(*) AS OPPS,\n    ROUND(SUM(O.AMOUNT) / 1e6, 2) AS AMOUNT_M,\n    ROUND(AVG(O.PROBABILITY_PCT), 0) AS PROBABILITY\nFROM BP_DEMO.CURATED.DT_OPPS_FLAT O\nLEFT JOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON O.GRANT_ID_REF = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nGROUP BY\n    O.STAGE\nORDER BY\n    STAGE_ORDER",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-opp-donor-type": {
      "type": "sql",
      "columns": [
        {
          "name": "DONOR_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "WEIGHTED_M",
          "type": "NUMBER"
        },
        {
          "name": "COMMITTED_M",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    O.DONOR_TYPE,\n    ROUND(SUM(IFF(O.STAGE NOT IN ('Closed Won', 'Closed Lost'), O.AMOUNT * O.PROBABILITY_PCT / 100, 0)) / 1e6, 2) AS WEIGHTED_M,\n    ROUND(SUM(IFF(O.STAGE IN ('Committed', 'Closed Won'), O.AMOUNT, 0)) / 1e6, 2) AS COMMITTED_M\nFROM BP_DEMO.CURATED.DT_OPPS_FLAT O\nLEFT JOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON O.GRANT_ID_REF = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nGROUP BY\n    O.DONOR_TYPE\nORDER BY\n    COMMITTED_M DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-top-donors": {
      "type": "sql",
      "columns": [
        {
          "name": "DONOR",
          "type": "VARCHAR"
        },
        {
          "name": "DONOR_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "AMOUNT_M",
          "type": "NUMBER"
        },
        {
          "name": "OPPS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    O.ACCOUNT_NAME AS DONOR,\n    ANY_VALUE(O.DONOR_TYPE) AS DONOR_TYPE,\n    ROUND(SUM(O.AMOUNT) / 1e6, 2) AS AMOUNT_M,\n    COUNT(*) AS OPPS\nFROM BP_DEMO.CURATED.DT_OPPS_FLAT O\nLEFT JOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON O.GRANT_ID_REF = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nGROUP BY\n    O.ACCOUNT_NAME\nORDER BY\n    AMOUNT_M DESC\nLIMIT {{ var('donor_top_n') }}",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "variable_bindings": [
        {
          "variable_id": "donor_top_n"
        }
      ]
    },
    "ds-sentiment": {
      "type": "sql",
      "columns": [
        {
          "name": "SENTIMENT_BAND",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    FLOOR(AVG_DONOR_SENTIMENT * 10) / 10 AS SENTIMENT_BAND,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\n    AND AVG_DONOR_SENTIMENT IS NOT NULL\nGROUP BY\n    1\nORDER BY\n    1",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-opp-close": {
      "type": "sql",
      "columns": [
        {
          "name": "CLOSE_MONTH",
          "type": "DATE"
        },
        {
          "name": "PIPELINE_TYPE",
          "type": "VARCHAR"
        },
        {
          "name": "AMOUNT_M",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    DATE_TRUNC('MONTH', O.CLOSE_DATE)::DATE AS CLOSE_MONTH,\n    IFF(O.STAGE IN ('Committed', 'Closed Won'), 'Committed / won', 'Open (weighted)') AS PIPELINE_TYPE,\n    ROUND(SUM(IFF(O.STAGE IN ('Committed', 'Closed Won'), O.AMOUNT, O.AMOUNT * O.PROBABILITY_PCT / 100)) / 1e6, 2) AS AMOUNT_M\nFROM BP_DEMO.CURATED.DT_OPPS_FLAT O\nLEFT JOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON O.GRANT_ID_REF = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\n    AND O.STAGE <> 'Closed Lost'\nGROUP BY\n    1,\n    2\nORDER BY\n    1",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-budget-line": {
      "type": "sql",
      "columns": [
        {
          "name": "BUDGET_LINE",
          "type": "VARCHAR"
        },
        {
          "name": "BUDGET_M",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    B.BUDGET_LINE,\n    ROUND(SUM(B.BUDGET_AMOUNT) / 1e6, 2) AS BUDGET_M\nFROM BP_DEMO.CURATED.DT_GRANT_BUDGET B\nJOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON B.GRANT_ID = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nGROUP BY\n    B.BUDGET_LINE\nORDER BY\n    BUDGET_M DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-budget-vs-approved": {
      "type": "sql",
      "columns": [
        {
          "name": "PROGRAM_AREA",
          "type": "VARCHAR"
        },
        {
          "name": "BUDGET_M",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED_M",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH b AS (\n    SELECT\n        B.GRANT_ID,\n        SUM(B.BUDGET_AMOUNT) AS BUDGET\n    FROM BP_DEMO.CURATED.DT_GRANT_BUDGET B\n    GROUP BY\n        B.GRANT_ID\n)\nSELECT\n    G.PROGRAM_AREA,\n    ROUND(SUM(b.BUDGET) / 1e6, 2) AS BUDGET_M,\n    ROUND(SUM(COALESCE(G.APPROVED_AMOUNT, 0)) / 1e6, 2) AS APPROVED_M\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE G\nJOIN b\n    ON b.GRANT_ID = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nGROUP BY\n    G.PROGRAM_AREA\nORDER BY\n    BUDGET_M DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-budget-variance": {
      "type": "sql",
      "columns": [
        {
          "name": "GRANT_ID",
          "type": "VARCHAR"
        },
        {
          "name": "ORGANIZATION",
          "type": "VARCHAR"
        },
        {
          "name": "PROGRAM",
          "type": "VARCHAR"
        },
        {
          "name": "STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "BUDGET",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED",
          "type": "NUMBER"
        },
        {
          "name": "GAP",
          "type": "NUMBER"
        },
        {
          "name": "FUNDED_PCT",
          "type": "NUMBER"
        },
        {
          "name": "FLAG",
          "type": "VARCHAR"
        }
      ],
      "sql": "WITH b AS (\n    SELECT\n        B.GRANT_ID,\n        SUM(B.BUDGET_AMOUNT) AS BUDGET\n    FROM BP_DEMO.CURATED.DT_GRANT_BUDGET B\n    GROUP BY\n        B.GRANT_ID\n)\nSELECT\n    G.GRANT_ID,\n    G.ORGANIZATION_NAME AS ORGANIZATION,\n    G.PROGRAM_AREA AS PROGRAM,\n    G.STATUS,\n    ROUND(b.BUDGET, 0) AS BUDGET,\n    G.APPROVED_AMOUNT AS APPROVED,\n    ROUND(b.BUDGET - G.APPROVED_AMOUNT, 0) AS GAP,\n    G.APPROVED_AMOUNT / NULLIF(b.BUDGET, 0) AS FUNDED_PCT,\n    CASE\n        WHEN G.APPROVED_AMOUNT / NULLIF(b.BUDGET, 0) < 0.7 THEN '▼ Under-funded'\n        WHEN G.APPROVED_AMOUNT / NULLIF(b.BUDGET, 0) < 0.9 THEN '● Partial'\n        ELSE '▲ Fully funded'\n    END AS FLAG\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE G\nJOIN b\n    ON b.GRANT_ID = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\n    AND G.STATUS IN ('Approved', 'Paid')\nORDER BY\n    GAP DESC\nLIMIT {{ var('top_n') }}",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "variable_bindings": [
        {
          "variable_id": "top_n"
        }
      ]
    },
    "ds-budget-tree": {
      "type": "sql",
      "columns": [
        {
          "name": "BUDGET",
          "type": "NUMBER"
        },
        {
          "name": "LINES",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH base AS (\n    SELECT\n        G.PROGRAM_AREA,\n        G.GRANT_ID,\n        G.GRANT_ID || ' · ' || G.ORGANIZATION_NAME AS GRANT_LABEL,\n        G.GRANT_ID || ' | ' || B.BUDGET_LINE AS LINE_KEY,\n        B.BUDGET_LINE,\n        B.BUDGET_AMOUNT\n    FROM BP_DEMO.CURATED.DT_GRANT_BUDGET B\n    JOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n        ON B.GRANT_ID = G.GRANT_ID\n    WHERE\n        {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n        AND {{ filter('REGION', 'G.REGION') }}\n        AND {{ filter('STATUS', 'G.STATUS') }}\n        AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n        AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n        AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\n)\nSELECT\n    {{ hierarchy_key('budget') }},\n    SUM(BUDGET_AMOUNT) AS BUDGET,\n    COUNT(*) AS LINES\nFROM base\nWHERE\n    {{ hierarchy_rows('budget') }}\nGROUP BY\n    {{ hierarchy_key('budget') }}\nORDER BY\n    BUDGET DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "hierarchy_bindings": [
        {
          "hierarchy_id": "budget"
        }
      ]
    },
    "ds-budget-pivot": {
      "type": "sql",
      "columns": [
        {
          "name": "PROGRAM_AREA",
          "type": "VARCHAR"
        },
        {
          "name": "PROGRAM_DELIVE",
          "type": "NUMBER"
        },
        {
          "name": "OVERHEAD",
          "type": "NUMBER"
        },
        {
          "name": "ADVOCACY_COMMU",
          "type": "NUMBER"
        },
        {
          "name": "EVALUATION_DAT",
          "type": "NUMBER"
        },
        {
          "name": "TECHNOLOGY",
          "type": "NUMBER"
        },
        {
          "name": "PERSONNEL",
          "type": "NUMBER"
        },
        {
          "name": "TOTAL",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    G.PROGRAM_AREA,\n    SUM(IFF(B.BUDGET_LINE = 'Program Delivery', B.BUDGET_AMOUNT, 0)) AS PROGRAM_DELIVE,\n    SUM(IFF(B.BUDGET_LINE = 'Overhead', B.BUDGET_AMOUNT, 0)) AS OVERHEAD,\n    SUM(IFF(B.BUDGET_LINE = 'Advocacy & Communications', B.BUDGET_AMOUNT, 0)) AS ADVOCACY_COMMU,\n    SUM(IFF(B.BUDGET_LINE = 'Evaluation & Data', B.BUDGET_AMOUNT, 0)) AS EVALUATION_DAT,\n    SUM(IFF(B.BUDGET_LINE = 'Technology', B.BUDGET_AMOUNT, 0)) AS TECHNOLOGY,\n    SUM(IFF(B.BUDGET_LINE = 'Personnel', B.BUDGET_AMOUNT, 0)) AS PERSONNEL,\n    SUM(B.BUDGET_AMOUNT) AS TOTAL\nFROM BP_DEMO.CURATED.DT_GRANT_BUDGET B\nJOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON B.GRANT_ID = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nGROUP BY\n    G.PROGRAM_AREA\nORDER BY\n    TOTAL DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-risk-amounts": {
      "type": "sql",
      "columns": [
        {
          "name": "RISK_RATING",
          "type": "VARCHAR"
        },
        {
          "name": "REQUESTED_M",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED_M",
          "type": "NUMBER"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    RISK_RATING,\n    ROUND(SUM(REQUESTED_AMOUNT) / 1e6, 2) AS REQUESTED_M,\n    ROUND(SUM(COALESCE(APPROVED_AMOUNT, 0)) / 1e6, 2) AS APPROVED_M,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    RISK_RATING",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-ai-risk": {
      "type": "sql",
      "columns": [
        {
          "name": "AI_RISK",
          "type": "VARCHAR"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        },
        {
          "name": "AVG_SCORE",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    AI_PRIMARY_RISK AS AI_RISK,\n    COUNT(*) AS GRANTS,\n    ROUND(AVG(REVIEWER_SCORE), 2) AS AVG_SCORE\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    AI_PRIMARY_RISK\nORDER BY\n    GRANTS DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-score-band": {
      "type": "sql",
      "columns": [
        {
          "name": "SCORE_BAND",
          "type": "VARCHAR"
        },
        {
          "name": "OUTCOME",
          "type": "VARCHAR"
        },
        {
          "name": "GRANTS",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    TO_VARCHAR(FLOOR(REVIEWER_SCORE)) || '.0–' || TO_VARCHAR(FLOOR(REVIEWER_SCORE)) || '.9' AS SCORE_BAND,\n    CASE\n        WHEN STATUS IN ('Approved', 'Paid') THEN 'Won'\n        WHEN STATUS = 'Declined' THEN 'Declined'\n        ELSE 'Pending'\n    END AS OUTCOME,\n    COUNT(*) AS GRANTS\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\nGROUP BY\n    1,\n    2",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-score-scatter": {
      "type": "sql",
      "columns": [
        {
          "name": "GRANT_ID",
          "type": "VARCHAR"
        },
        {
          "name": "ORGANIZATION",
          "type": "VARCHAR"
        },
        {
          "name": "STATUS",
          "type": "VARCHAR"
        },
        {
          "name": "REVIEWER_SCORE",
          "type": "NUMBER"
        },
        {
          "name": "REQUESTED_K",
          "type": "NUMBER"
        }
      ],
      "sql": "SELECT\n    GRANT_ID,\n    ORGANIZATION_NAME AS ORGANIZATION,\n    STATUS,\n    REVIEWER_SCORE,\n    ROUND(REQUESTED_AMOUNT / 1e3, 0) AS REQUESTED_K\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-high-risk-review": {
      "type": "sql",
      "columns": [
        {
          "name": "GRANT_ID",
          "type": "VARCHAR"
        },
        {
          "name": "ORGANIZATION",
          "type": "VARCHAR"
        },
        {
          "name": "PROGRAM",
          "type": "VARCHAR"
        },
        {
          "name": "SCORE",
          "type": "NUMBER"
        },
        {
          "name": "REQUESTED",
          "type": "NUMBER"
        },
        {
          "name": "AI_RISK",
          "type": "VARCHAR"
        },
        {
          "name": "AI_SUMMARY",
          "type": "VARCHAR"
        }
      ],
      "sql": "SELECT\n    GRANT_ID,\n    ORGANIZATION_NAME AS ORGANIZATION,\n    PROGRAM_AREA AS PROGRAM,\n    REVIEWER_SCORE AS SCORE,\n    REQUESTED_AMOUNT AS REQUESTED,\n    AI_PRIMARY_RISK AS AI_RISK,\n    AI_REVIEWER_SUMMARY AS AI_SUMMARY\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nWHERE\n    {{ filter('PROGRAM_AREA') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('STATUS') }}\n    AND {{ filter('RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE') }}\n    AND RISK_RATING = 'High'\n    AND STATUS IN ('Under Review', 'Submitted')\nORDER BY\n    REQUESTED_AMOUNT DESC",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ]
    },
    "ds-detail": {
      "type": "sql",
      "columns": [
        {
          "name": "GRANT_ID",
          "type": "VARCHAR"
        },
        {
          "name": "ORGANIZATION",
          "type": "VARCHAR"
        },
        {
          "name": "PROGRAM",
          "type": "VARCHAR"
        },
        {
          "name": "REGION",
          "type": "VARCHAR"
        },
        {
          "name": "STATUS_FLAG",
          "type": "VARCHAR"
        },
        {
          "name": "RISK_FLAG",
          "type": "VARCHAR"
        },
        {
          "name": "SCORE",
          "type": "NUMBER"
        },
        {
          "name": "REQUESTED",
          "type": "NUMBER"
        },
        {
          "name": "APPROVED",
          "type": "NUMBER"
        },
        {
          "name": "PIPELINE",
          "type": "NUMBER"
        },
        {
          "name": "WEIGHTED",
          "type": "NUMBER"
        },
        {
          "name": "COMMITTED",
          "type": "NUMBER"
        },
        {
          "name": "SUBMITTED",
          "type": "DATE"
        },
        {
          "name": "DECIDED",
          "type": "DATE"
        },
        {
          "name": "AI_RISK",
          "type": "VARCHAR"
        }
      ],
      "sql": "SELECT\n    F.GRANT_ID,\n    F.ORGANIZATION_NAME AS ORGANIZATION,\n    F.PROGRAM_AREA AS PROGRAM,\n    F.REGION,\n    CASE\n        WHEN F.STATUS IN ('Approved', 'Paid') THEN '▲ ' || F.STATUS\n        WHEN F.STATUS = 'Declined' THEN '▼ ' || F.STATUS\n        ELSE '● ' || F.STATUS\n    END AS STATUS_FLAG,\n    CASE F.RISK_RATING\n        WHEN 'High' THEN '■■■ High'\n        WHEN 'Medium' THEN '■■□ Medium'\n        ELSE '■□□ Low'\n    END AS RISK_FLAG,\n    F.REVIEWER_SCORE AS SCORE,\n    F.REQUESTED_AMOUNT AS REQUESTED,\n    F.APPROVED_AMOUNT AS APPROVED,\n    G.PIPELINE_AMOUNT AS PIPELINE,\n    G.WEIGHTED_PIPELINE_AMOUNT AS WEIGHTED,\n    G.COMMITTED_AMOUNT AS COMMITTED,\n    F.SUBMITTED_DATE AS SUBMITTED,\n    F.DECISION_DATE AS DECIDED,\n    G.AI_PRIMARY_RISK AS AI_RISK\nFROM BP_DEMO.CURATED.DT_GRANTS_FLAT F\nJOIN BP_DEMO.CURATED.DT_GRANT_PIPELINE G\n    ON F.GRANT_ID = G.GRANT_ID\nWHERE\n    {{ filter('PROGRAM_AREA', 'G.PROGRAM_AREA') }}\n    AND {{ filter('REGION', 'G.REGION') }}\n    AND {{ filter('STATUS', 'G.STATUS') }}\n    AND {{ filter('RISK_RATING', 'G.RISK_RATING') }}\n    AND {{ filter('PROGRAM_OFFICER', 'G.PROGRAM_OFFICER') }}\n    AND {{ filter('SUBMITTED_DATE', 'G.SUBMITTED_DATE') }}\nORDER BY\n    G.WEIGHTED_PIPELINE_AMOUNT DESC\nLIMIT {{ var('top_n') }}",
      "filter_bindings": [
        {
          "filter_id": "PROGRAM_AREA"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "STATUS"
        },
        {
          "filter_id": "RISK_RATING"
        },
        {
          "filter_id": "PROGRAM_OFFICER"
        },
        {
          "filter_id": "SUBMITTED_DATE"
        }
      ],
      "variable_bindings": [
        {
          "variable_id": "top_n"
        }
      ]
    },
    "ds-PROGRAM_OFFICER-options": {
      "type": "sql",
      "sql": "SELECT DISTINCT PROGRAM_OFFICER\nFROM BP_DEMO.CURATED.DT_GRANT_PIPELINE\nORDER BY\n    PROGRAM_OFFICER"
    }
  },
