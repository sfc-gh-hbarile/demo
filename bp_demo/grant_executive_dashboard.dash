  "tabs": [
    {
      "tab_id": "overview",
      "title": "Executive Overview",
      "tiles": [
        {
          "tile_id": "ov-intro",
          "type": "text",
          "title": "About this view",
          "text": "**Portfolio health at a glance.** Use the filters at the top to narrow every tile on every tab to a program, region, status, risk rating, officer or submission window. All figures are live queries on `BP_DEMO.CURATED`."
        },
        {
          "tile_id": "kpi-grants",
          "type": "chart",
          "title": "Grant applications",
          "datasources": [
            "ds-kpi-trend"
          ],
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "GRANTS",
                  "labelField": "",
                  "format": "decimal",
                  "decimals": 0,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "sparklineEnabled": true,
                  "labelEnabled": false,
                  "seriesBucketField": "QTR",
                  "seriesBucketFieldType": "temporal",
                  "seriesValueField": "Q_GRANTS",
                  "sparklineColorMode": "fixed"
                }
              }
            }
          }
        },
