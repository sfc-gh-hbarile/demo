                "type": "nominal",
                "title": null,
                "scale": {
                  "range": [
                    "#11567F",
                    "#FF9F36"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "CLOSE_MONTH",
                  "type": "temporal",
                  "title": "Month"
                },
                {
                  "field": "PIPELINE_TYPE",
                  "type": "nominal"
                },
                {
                  "field": "AMOUNT_M",
                  "type": "quantitative",
                  "title": "$M"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "tab_id": "budget",
      "title": "Budget & Financials",
      "tiles": [
        {
          "tile_id": "bg-intro",
          "type": "text",
          "title": "About this view",
          "text": "**How grant budgets are allocated and how much of each budget we fund.** Budget lines come from `DT_GRANT_BUDGET` (6 lines per grant). The variance table shows the approved grants with the largest gap between budget and approved amount."
        },
        {
          "tile_id": "budget-line-donut",
          "type": "chart",
          "title": "Budget by line item ($M)",
          "datasources": [
            "ds-budget-line"
          ],
          "spec": {
            "mark": "arc",
            "encoding": {
              "theta": {
                "field": "BUDGET_M",
                "type": "quantitative"
              },
              "color": {
                "field": "BUDGET_LINE",
                "type": "nominal",
                "title": "Budget line"
              },
              "tooltip": [
                {
                  "field": "BUDGET_LINE",
                  "type": "nominal"
                },
                {
                  "field": "BUDGET_M",
                  "type": "quantitative",
                  "title": "$M"
                }
              ]
            },
            "usermeta": {
              "snowflake": {
                "chartConfig": {
                  "innerRadius": 55,
                  "centerTotal": {
                    "enabled": true
                  },
                  "dataLabels": {
                    "enabled": true
                  }
                }
              }
            }
          }
        },
        {
          "tile_id": "budget-vs-approved",
          "type": "chart",
          "title": "Total budget vs approved by program ($M)",
          "datasources": [
            "ds-budget-vs-approved"
          ],
          "spec": {
            "transform": [
              {
                "fold": [
                  "BUDGET_M",
                  "APPROVED_M"
                ],
                "as": [
                  "MEASURE",
                  "USD_M"
                ]
              }
            ],
            "mark": "bar",
            "encoding": {
              "x": {
                "field": "PROGRAM_AREA",
                "type": "nominal",
                "title": null
              },
              "xOffset": {
                "field": "MEASURE",
                "type": "nominal"
              },
              "y": {
                "field": "USD_M",
                "type": "quantitative",
                "title": "$M"
              },
              "color": {
                "field": "MEASURE",
                "type": "nominal",
                "title": "Measure",
                "scale": {
                  "domain": [
                    "BUDGET_M",
                    "APPROVED_M"
                  ],
                  "range": [
                    "#8A99AD",
                    "#29B5E8"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "PROGRAM_AREA",
                  "type": "nominal"
                },
                {
                  "field": "MEASURE",
                  "type": "nominal"
                },
                {
                  "field": "USD_M",
                  "type": "quantitative",
                  "title": "$M"
                }
              ]
            }
          }
        },
        {
          "tile_id": "budget-pivot",
          "type": "table",
          "title": "Pivot: program area × budget line ($)",
          "datasources": [
            "ds-budget-pivot"
          ],
          "spec": {
            "columns": [
              {
                "field": "PROGRAM_AREA"
              },
              {
                "field": "PROGRAM_DELIVE",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "OVERHEAD",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "ADVOCACY_COMMU",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "EVALUATION_DAT",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "TECHNOLOGY",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "PERSONNEL",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "TOTAL",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              }
            ],
            "sort": [
              {
                "field": "TOTAL",
                "direction": "desc"
              }
            ]
          }
        },
        {
          "tile_id": "budget-tree",
          "type": "table",
          "title": "Program → grant → budget line (expand rows)",
          "datasources": [
            "ds-budget-tree"
          ],
          "spec": {
            "columns": [
              {
                "field": "LEVEL_LABEL",
                "label": "Program / grant / line"
              },
              {
                "field": "BUDGET",
                "label": "Budget",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "LINES",
                "label": "Budget lines",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true
                  }
                }
              }
            ]
          }
        },
        {
          "tile_id": "budget-variance",
          "type": "table",
          "title": "Budget variance on approved grants: largest gaps (Top N control)",
          "datasources": [
            "ds-budget-variance"
          ],
          "spec": {
            "columns": [
              {
                "field": "GRANT_ID"
              },
              {
                "field": "ORGANIZATION"
              },
              {
                "field": "PROGRAM"
              },
              {
                "field": "STATUS"
              },
              {
                "field": "BUDGET",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "APPROVED",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "GAP",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "FUNDED_PCT",
                "format": {
                  "number": {
                    "style": "percent",
                    "precision": 0
                  }
                }
              },
              {
                "field": "FLAG"
              }
            ],
            "sort": [
              {
                "field": "GAP",
                "direction": "desc"
              }
            ]
          }
        }
      ]
    },
    {
      "tab_id": "risk",
      "title": "Risk & AI Insights",
      "tiles": [
        {
          "tile_id": "rk-intro",
          "type": "text",
          "title": "About this view",
          "text": "**Is risk being managed, and what does the AI reviewer flag?** `AI_PRIMARY_RISK` and `AI_REVIEWER_SUMMARY` are generated by Cortex AI from free-text reviewer notes. Click a status in the scatter legend to highlight it."
        },
        {
          "tile_id": "risk-amounts",
          "type": "chart",
          "title": "Requested vs approved by risk rating ($M)",
          "datasources": [
            "ds-risk-amounts"
          ],
          "spec": {
            "transform": [
              {
                "fold": [
                  "REQUESTED_M",
                  "APPROVED_M"
                ],
                "as": [
                  "MEASURE",
                  "USD_M"
                ]
              }
            ],
            "mark": "bar",
            "encoding": {
              "x": {
                "field": "RISK_RATING",
                "type": "nominal",
                "sort": [
                  "Low",
                  "Medium",
                  "High"
                ],
                "title": "Risk rating"
              },
              "xOffset": {
                "field": "MEASURE",
                "type": "nominal"
              },
              "y": {
                "field": "USD_M",
                "type": "quantitative",
                "title": "$M"
              },
              "color": {
                "field": "MEASURE",
                "type": "nominal",
                "title": "Measure",
                "scale": {
                  "domain": [
                    "REQUESTED_M",
                    "APPROVED_M"
                  ],
                  "range": [
                    "#11567F",
                    "#29B5E8"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "RISK_RATING",
                  "type": "nominal"
                },
                {
                  "field": "MEASURE",
                  "type": "nominal"
                },
                {
                  "field": "USD_M",
                  "type": "quantitative",
                  "title": "$M"
                },
                {
                  "field": "GRANTS",
                  "type": "quantitative"
                }
              ]
            }
          }
        },
        {
          "tile_id": "ai-risk-combo",
          "type": "chart",
          "title": "AI-identified primary risk: grants (bars) vs avg reviewer score (line)",
          "datasources": [
            "ds-ai-risk"
          ],
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "bar",
                  "color": "#7D44CF"
                },
                "encoding": {
                  "x": {
                    "field": "AI_RISK",
                    "type": "nominal",
                    "sort": "-y",
                    "title": null,
                    "axis": {
                      "labelAngle": -20
                    }
                  },
                  "y": {
                    "field": "GRANTS",
                    "type": "quantitative",
                    "title": "Grants"
                  },
                  "tooltip": [
                    {
                      "field": "AI_RISK",
                      "type": "nominal"
                    },
                    {
                      "field": "GRANTS",
                      "type": "quantitative"
                    },
                    {
                      "field": "AVG_SCORE",
                      "type": "quantitative",
                      "title": "Avg score"
                    }
                  ]
                }
              },
              {
                "mark": {
                  "type": "line",
                  "color": "#FF9F36",
                  "strokeWidth": 3,
                  "point": true
                },
                "encoding": {
                  "x": {
                    "field": "AI_RISK",
                    "type": "nominal",
                    "sort": "-y"
                  },
                  "y": {
                    "field": "AVG_SCORE",
                    "type": "quantitative",
                    "title": "Avg reviewer score",
                    "scale": {
                      "domain": [
                        1,
                        5
                      ]
                    }
                  }
                }
              }
            ],
            "resolve": {
              "scale": {
                "y": "independent"
              }
            }
          }
        },
        {
          "tile_id": "score-band",
          "type": "chart",
          "title": "Outcome by reviewer score band (stacked)",
          "datasources": [
            "ds-score-band"
          ],
          "spec": {
            "mark": "bar",
            "encoding": {
              "x": {
                "field": "SCORE_BAND",
                "type": "ordinal",
                "title": "Reviewer score"
              },
              "y": {
                "field": "GRANTS",
                "type": "quantitative",
                "title": "Grants"
              },
              "color": {
                "field": "OUTCOME",
                "type": "nominal",
                "title": "Outcome",
                "scale": {
                  "domain": [
                    "Won",
                    "Pending",
                    "Declined"
                  ],
                  "range": [
                    "#5FBF8F",
                    "#FFD166",
                    "#D45B90"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "SCORE_BAND",
                  "type": "ordinal"
                },
                {
                  "field": "OUTCOME",
                  "type": "nominal"
                },
                {
                  "field": "GRANTS",
                  "type": "quantitative"
                }
              ]
            },
            "usermeta": {
              "snowflake": {
                "chartConfig": {
                  "dataLabels": {
                    "enabled": true
                  }
                }
              }
            }
          }
        },
        {
          "tile_id": "score-scatter",
          "type": "chart",
          "title": "Reviewer score vs requested amount ($K), by status",
          "datasources": [
            "ds-score-scatter"
          ],
          "spec": {
            "mark": {
              "type": "point",
              "filled": true,
              "opacity": 0.7,
              "size": 45
            },
            "encoding": {
              "x": {
                "field": "REVIEWER_SCORE",
                "type": "quantitative",
                "title": "Reviewer score"
              },
              "y": {
                "field": "REQUESTED_K",
                "type": "quantitative",
                "title": "Requested ($K)"
              },
              "color": {
                "field": "STATUS",
                "type": "nominal",
                "title": "Status",
                "scale": {
                  "domain": [
                    "Paid",
                    "Approved",
                    "Under Review",
                    "Submitted",
                    "Draft",
                    "Declined"
                  ],
                  "range": [
                    "#11567F",
                    "#29B5E8",
                    "#FF9F36",
                    "#FFD166",
                    "#8A99AD",
                    "#D45B90"
                  ]
                }
              },
              "tooltip": [
                {
                  "field": "GRANT_ID",
                  "type": "nominal"
                },
                {
                  "field": "ORGANIZATION",
                  "type": "nominal"
                },
                {
                  "field": "STATUS",
                  "type": "nominal"
                },
                {
                  "field": "REVIEWER_SCORE",
                  "type": "quantitative"
                },
                {
                  "field": "REQUESTED_K",
                  "type": "quantitative",
                  "title": "$K"
                }
              ]
            }
          },
          "scope": "status_highlight",
          "interactions": [
            {
              "trigger": "select",
              "fields": [
                "STATUS"
              ],
              "operator": "set_selection",
              "targets": [
                {
                  "scope": "status_highlight",
                  "fields": [
                    "STATUS"
                  ],
                  "selection": "STATUS"
                }
              ]
            }
          ]
        },
        {
          "tile_id": "high-risk-review",
          "type": "table",
          "title": "High-risk grants awaiting decision, with AI reviewer summary",
          "datasources": [
            "ds-high-risk-review"
          ],
          "spec": {
            "columns": [
              {
                "field": "GRANT_ID"
              },
              {
                "field": "ORGANIZATION"
              },
              {
                "field": "PROGRAM"
              },
              {
                "field": "SCORE",
                "format": {
                  "number": {
                    "precision": 1
                  }
                }
              },
              {
                "field": "REQUESTED",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "AI_RISK"
              },
              {
                "field": "AI_SUMMARY"
              }
            ],
            "sort": [
              {
                "field": "REQUESTED",
                "direction": "desc"
              }
            ]
          }
        }
      ]
    },
    {
      "tab_id": "detail",
      "title": "Detail",
      "tiles": [
        {
          "tile_id": "dt-intro",
          "type": "text",
          "title": "About this view",
          "text": "**Grant-level drill-through.** The top grants by weighted donor pipeline (default 25; use **Top N grants** to change). Click any header to re-sort. Markers: ▲ won, ▼ declined, ● in progress; ■ bars show risk level."
        },
        {
          "tile_id": "grant-detail",
          "type": "table",
          "title": "Top grants by weighted donor pipeline",
          "datasources": [
            "ds-detail"
          ],
          "spec": {
            "columns": [
              {
                "field": "GRANT_ID"
              },
              {
                "field": "ORGANIZATION"
              },
              {
                "field": "PROGRAM"
              },
              {
                "field": "REGION"
              },
              {
                "field": "STATUS_FLAG"
              },
              {
                "field": "RISK_FLAG"
              },
              {
                "field": "SCORE",
                "format": {
                  "number": {
                    "precision": 1
                  }
                }
              },
              {
                "field": "REQUESTED",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "APPROVED",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "PIPELINE",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "WEIGHTED",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "COMMITTED",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true,
                    "prefix": "$"
                  }
                }
              },
              {
                "field": "SUBMITTED",
                "format": {
                  "date": {
                    "date_format": "ISO_DATE"
                  }
                }
              },
              {
                "field": "DECIDED",
                "format": {
                  "date": {
                    "date_format": "ISO_DATE"
                  }
                }
              },
              {
                "field": "AI_RISK"
              }
            ],
            "sort": [
              {
                "field": "WEIGHTED",
                "direction": "desc"
              }
            ]
          }
        }
      ]
    }
  ]
}