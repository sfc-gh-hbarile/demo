              {
                "field": "LEVEL_LABEL",
                "label": "Geography"
              },
              {
                "field": "GRANTS",
                "label": "Grants",
                "format": {
                  "number": {
                    "precision": 0,
                    "thousands_sep": true
                  }
                }
              },
              {
                "field": "REQUESTED",
