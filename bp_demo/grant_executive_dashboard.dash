                  },
                  "y": {
                    "field": "PROGRAM_AREA",
                    "type": "nominal"
                  },
                  "text": {
                    "field": "APPROVED_M",
                    "type": "quantitative",
                    "format": ".1f"
                  },
                  "color": {
                    "condition": {
                      "test": "datum.APPROVED_M > 12",
                      "value": "white"
                    },
                    "value": "#1f2937"
                  }
                }
              }
            ]
