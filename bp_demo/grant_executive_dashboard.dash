          ],
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "currentColumn": "OPP_WIN_RATE",
                  "labelField": "",
                  "format": "percent",
                  "decimals": 1,
                  "abbreviate": false,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "sparklineEnabled": false,
                  "labelEnabled": false,
                  "thresholds": [
                    {
                      "slot": "alert",
                      "comparator": "lt",
                      "value": 0.6,
                      "color": "red"
                    },
                    {
                      "slot": "warn",
                      "comparator": "between",
                      "value": 0.6,
                      "value2": 0.7,
                      "color": "yellow"
                    },
                    {
                      "slot": "good",
                      "comparator": "gte",
                      "value": 0.7,
                      "color": "green"
                    }
                  ],
                  "thresholdDirection": "higher-is-better"
                }
